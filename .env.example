DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

REDIS_URL=redis://localhost:6379

# Local dev: list all origins that may call the API
# Production: https://stratanodex.online,https://www.stratanodex.online,https://app.stratanodex.online
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# CLI auth redirect target — where browser opens for CLI login
# Local dev: http://localhost:3001  |  Production: https://stratanodex.online
WEB_APP_URL=http://localhost:3001

# Shared secret between landing page and backend for CLI session handshake
CLI_SESSION_SECRET=replace_with_a_long_random_string

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your@email.com

